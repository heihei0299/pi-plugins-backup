{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "path": {
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      ".pi/agent/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      ".pi/agent/models.json": "deny",
      "~/.pi/agent/models.json": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "*/users/*/.pi/agent/skills/*": "allow",
      "*/users/*/.pi/agent/npm/*": "allow",
      "*/users/*/.pi/agent/sessions/*": "allow",
      "*/users/*/.pi/agent/repos/*": "allow",
      "*/node_modules/@earendil-works/*": "allow",
      "*/node_modules/@earendil-works": "allow",
      "*/dev/null*": "allow"
    },
    "bash": {
      "grep *": "deny",
      "find *": "deny",
      "Remove-Item *": "ask",
      "remove-item *": "ask",
      "rm *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "rmdir *": "ask",
      "ri *": "ask",
      "mv *": "ask",
      "cmd /c del *": "ask",
      "cmd /c erase *": "ask",
      "cmd /c rd *": "ask",
      "cmd /c rmdir *": "ask",
      "cmd.exe /c del *": "ask",
      "cmd.exe /c erase *": "ask",
      "cmd.exe /c rd *": "ask",
      "cmd.exe /c rmdir *": "ask",
      "powershell *Remove-Item*": "ask",
      "powershell.exe *Remove-Item*": "ask",
      "pwsh *Remove-Item*": "ask",
      "pwsh.exe *Remove-Item*": "ask",
      "git clean *": "ask",
      "git reset --hard *": "ask",
      "git checkout -- *": "deny",
      "git restore *": "ask",
      "Set-Content *": "ask",
      "Out-File *": "ask",
      "Move-Item *": "ask",
      "Rename-Item *": "ask",
      "git push *": "allow",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git pull *": "deny",
      "git merge origin/*": "deny",
      "git merge origin *": "deny",
      "git merge upstream/*": "deny",
      "git merge upstream *": "deny",
      "git merge FETCH_HEAD *": "deny",
      "git merge -X*": "deny",
      "git merge * -X*": "deny",
      "git merge --strategy-option*": "deny",
      "git merge * --strategy-option*": "deny",
      "git merge -s ours*": "deny",
      "git merge * -s ours*": "deny",
      "git merge --strategy=ours*": "deny",
      "git merge * --strategy=ours*": "deny",
      "git merge --allow-unrelated-histories*": "deny",
      "git merge * --allow-unrelated-histories*": "deny",
      "dash": "deny",
      "ksh": "deny",
      "ash": "deny",
      "sh -s *": "deny",
      "bash -s *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny"
    },
    "grep": "deny",
    "find": "deny",
    "ffgrep": "allow",
    "fffind": "allow",
    "fff-multi-grep": "allow",
    "multi_grep": "deny"
  }
}
